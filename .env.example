# ── Database (docker-compose) ─────────────────────────────
POSTGRES_USER=dsa_user
POSTGRES_PASSWORD=dsa_pass
POSTGRES_DB=dsa_platform

# ── Backend ───────────────────────────────────────────────
# psycopg3 driver; host is localhost when running backend outside Docker
DATABASE_URL=postgresql+psycopg://dsa_user:dsa_pass@localhost:5432/dsa_platform

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Supabase (auth via JWKS; db via DATABASE_URL pooler) ────
SUPABASE_URL=
SUPABASE_SECRET_KEY=

CORS_ORIGINS=http://localhost:3000

# ── Judge0 CE (self-hosted via Docker) ────────────────────
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Judge0 database (separate PostgreSQL instance)
JUDGE0_DB_USER=judge0_user
JUDGE0_DB_PASS=judge0_pass
JUDGE0_DB_NAME=judge0
JUDGE0_SECRET_KEY=change-me-to-a-long-random-string

# ── Google Gemini (hints + reviews use GEMINI_API_KEY) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# ── Coach chat: Gemini rotation (KEY1..KEY5) + Groq fallback ──
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
