# ── Database (docker-compose) ─────────────────────────────
POSTGRES_USER=dsa_user
POSTGRES_PASSWORD=dsa_pass
POSTGRES_DB=dsa_platform

# ── Backend ───────────────────────────────────────────────
# psycopg3 driver; host is localhost when running backend outside Docker
DATABASE_URL=postgresql+psycopg://dsa_user:dsa_pass@localhost:5432/dsa_platform

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

# ── Judge0 CE (Phase 3) ───────────────────────────────────
# Self-hosted: http://localhost:2358  |  RapidAPI: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# ── Google Gemini (Phase 5) ───────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
